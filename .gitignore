_parts.*

# Decks and binaries dropped in this folder — publish = "." would serve them
*.pptx
*.pdf
*.key

# Harvested contact addresses. Ignored on purpose: publish = "." would serve
# them at haus.fund, and a harvest can pick up named individuals as well as
# generic inboxes. Review it, then `git add -f` it when you mean to publish.
tools/core-facility-finder/data/contacts.json

# Python bytecode from running the tools locally
__pycache__/
*.pyc
